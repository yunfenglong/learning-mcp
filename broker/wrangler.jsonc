{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "learning-sso-broker",
  "main": "worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "BROKER_STATE",
        "class_name": "BrokerState",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BrokerState"],
    },
  ],
  "vars": {
    "PLATFORM_CONFIG": "{}",
    "LOGIN_ORIGINS": "[]",
  },
  "observability": {
    "enabled": false,
  },
  "browser": {
    "binding": "BROWSER",
  },
}
